<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.vb.sandcastle</string>

  <!-- No root argument: every eligible root in the project is discovered. -->
  <key>ProgramArguments</key>
  <array>
    <string>/Users/vincentbattez/.local/bin/sandcastle-run.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/vincentbattez/lab/macosApp/wootonpad</string>

  <!-- Hourly. A tick is nearly free when there is nothing to do: the lock,
       the pause after an interruption and the quota gate all exit at once. -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/Users/vincentbattez/Library/Logs/sandcastle/out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/vincentbattez/Library/Logs/sandcastle/err.log</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
